{
  "name": "@openreachtech/jest-constructor-spy",
  "version": "1.1.2",
  "description": "`ConstructorSpy` is a module designed to spy on the constructor of JavaScript class in Jest. It allows developers to easily track and monitor the usage of the constructor in their Jest tests.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "config/",
    "lib/",
    "types/"
  ],
  "scripts": {
    "l": "npm run lint",
    "lint": "eslint .",
    "test": "export NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\"; export NODE_ENV=development; jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openreachtech/jest-constructor-spy.git"
  },
  "keywords": [
    "Jest",
    "spy",
    "constructor"
  ],
  "author": "Open Reach Tech Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/openreachtech/jest-constructor-spy/issues"
  },
  "homepage": "https://github.com/openreachtech/jest-constructor-spy#readme",
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=11.17.0"
  },
  "devDependencies": {
    "@openreachtech/eslint-config": "^4.5.0",
    "@openreachtech/mentsu-github-actions-inspector": "^0.1.0",
    "@openreachtech/mentsu-npm-audit-gate": "^0.2.0",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.2"
  },
  "overrides": {
    "@typescript-eslint/utils@7": "^8.71.2",
    "eslint-plugin-jest": "^28.14.0",
    "glob": "^14.0.2",
    "js-yaml": "^4.3.2",
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "unrs-resolver": false
  },
  "peerDependencies": {
    "@jest/globals": "^30.5.2"
  }
}
