{
  "name": "@openreachtech/jest-constructor-spy",
  "version": "1.1.2",
  "description": "`ConstructorSpy` is a module designed to spy on the constructor of JavaScript class in Jest. It allows developers to easily track and monitor the usage of the constructor in their Jest tests.",
  "files": [
    "config/",
    "index.mjs",
    "lib/",
    "types/"
  ],
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js",
      "node": "./index.js",
      "default": "./index.js"
    }
  },
  "scripts": {
    "l": "npm run lint",
    "lint": "eslint .",
    "test": "export NODE_ENV=development; jest --forceExit --detectOpenHandles"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openreachtech/jest-constructor-spy.git"
  },
  "keywords": [
    "Jest",
    "spy",
    "constructor"
  ],
  "author": "Open Reach Tech Inc.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/openreachtech/jest-constructor-spy/issues"
  },
  "homepage": "https://github.com/openreachtech/jest-constructor-spy#readme",
  "devDependencies": {
    "@openreachtech/eslint-config": "^3.0.2",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.2",
    "jest": "^30.4.2"
  }
}
